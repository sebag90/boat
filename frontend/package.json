{
  "name": "boat-organizer-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "smoke": "esbuild smoke/entry.tsx --bundle --outfile=smoke/bundle.cjs --format=cjs --platform=browser --jsx=automatic --loader:.css=empty --define:process.env.NODE_ENV='\"development\"' --log-level=warning && tsx smoke/run.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "dompurify": "^3.2.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.552.0",
    "marked": "^18.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^28.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.14"
  }
}
