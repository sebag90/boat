[Unit]
Description=Boat Frontend (nginx)

[Container]
ContainerName=boat-frontend
Image=ghcr.io/sebag90/boat-frontend:latest
AutoUpdate=registry

Pod=boat.pod

Label=traefik.enable=true
Label=traefik.http.routers.boat.rule=Host(`boat.giglis.eu`)
Label=traefik.http.routers.boat.entrypoints=websecure
Label=traefik.http.routers.boat.tls=true
Label=traefik.http.services.boat.loadbalancer.server.port=80
Label=traefik.http.routers.boat.tls.certresolver=letsencrypt

[Service]
Restart=always

[Install]
WantedBy=default.target
